# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.y85m2k4.mongodb.net/?appName=Cluster0

# Server Port
PORT=5000

# Admin Credentials (used to seed the initial admin account in MongoDB)
ADMIN_EMAIL=admin@mes.com
ADMIN_PASSWORD=your-strong-admin-password

# SuperAdmin Credentials (used to seed the initial SuperAdmin account in MongoDB)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=your-strong-superadmin-password

# JWT Secret — use a long random string (min 32 chars, recommend 64+ hex chars)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long

# Frontend API URL
VITE_API_URL=http://localhost:5000/api

# Resend API Key for Email Delivery
RESEND_API_KEY=your_resend_api_key

# App Frontend URL (used in password reset emails — use LAN IP for testing on mobile e.g. http://192.168.x.x:3000, or production URL)
APP_URL=http://192.168.1.24:3000

# Resend Sender Email (use onboarding@resend.dev for testing without verified domain)
RESEND_FROM_EMAIL=onboarding@resend.dev


