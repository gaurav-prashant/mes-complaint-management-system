# Node Environment
NODE_ENV=production

# Server Port (Render automatically injects PORT)
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.y85m2k4.mongodb.net/?appName=Cluster0

# JWT Secret — min 32 characters
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long

# Admin Credentials (initial seed)
ADMIN_EMAIL=admin@mes.com
ADMIN_PASSWORD=your-strong-admin-password

# SuperAdmin Credentials (initial seed)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=your-strong-superadmin-password

# Resend Email Service
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Production Frontend Base URL (used in password reset emails)
APP_URL=https://your-app-name.onrender.com

# Optional Frontend API URL override (defaults to same-origin /api if blank)
VITE_API_URL=


